# moly 배치 워커 — 1틱 실행 후 종료(멱등). moly-worker.timer가 15분마다 트리거.
# 이 파일은 moly-infra/systemd/ 가 원본이며, deploy.sh가 /etc/systemd/system/ 에 설치/갱신한다.
[Unit]
Description=Moly batch worker tick (diary/push, every 15 min)
Requires=docker.service
After=docker.service network-online.target
# 틱이 실패(TimeoutStartSec 초과·비정상 종료)하면 상태 채널에 한 줄 남긴다. 실패한 틱은 파이썬 쪽
# 요약·데드맨 핑을 못 보내고, 한 번뿐이면 다음 틱 핑에 묻혀 아무 신호도 남지 않는다.
OnFailure=moly-worker-failed.service

[Service]
Type=oneshot
WorkingDirectory=/root/moly-infra
# --env-file 명시: IMAGE_TAG(.env)를 cwd 탐색에 안 맡긴다 — 실패 시 무음 :latest 폴백 방지
ExecStart=/usr/bin/docker compose --env-file /root/moly-infra/.env -f /root/moly-infra/docker-compose.yml run --rm --quiet-pull worker
# 15분 케이던스 — 다음 틱 전에 끝나도록 상한을 둔다. 워커는 WORKER_TICK_SOFT_DEADLINE_S(기본 660s)에
# 스스로 유저 루프를 멈추고 후처리 뒤 끝나므로(그 시각의 마지막 틱은 끝까지 처리) 이 상한은 백스톱이다.
# 상한에 걸리면 systemd는 `docker compose run` 클라이언트만 종료한다 — 컨테이너는 끝까지 처리하지만
# 그 로그는 journald에 남지 않고 다음 틱 컨테이너와 겹친다. 중복 생성은 멱등(SOMA-373 claim +
# _diary_exists)이 막는다. Type=oneshot이라 실행 중이면 다음 트리거는 스킵된다.
TimeoutStartSec=14min
