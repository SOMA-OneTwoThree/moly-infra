# 매시 정각에 moly-worker.service 실행. deploy.sh가 설치/enable 한다.
# 워커 틱은 "유저 로컬시각의 hour"로 판단하므로 정각 직후 실행이 중요 (OnCalendar=hourly = *:00:00).
[Unit]
Description=Run Moly batch worker every hour on the hour

[Timer]
OnCalendar=hourly
# 재부팅 등으로 놓친 틱은 부팅 후 1회 즉시 실행 — 틱이 "현재 시각" 기준 멱등이라 안전
Persistent=true
# 정각 정확도 유지 (기본 1min이면 최대 1분 지연 — 허용 범위지만 명시)
AccuracySec=30s

[Install]
WantedBy=timers.target
